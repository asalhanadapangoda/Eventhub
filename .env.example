# ==============================================================================
# TRACE PROJECTS — UNIFIED SHARED ENVIRONMENT CONFIGURATION
# Shared by: Event & Space, TRACE Community, and Innovation Academy
# ==============================================================================

# Server Ports
EVENTS_PORT=5000
ACADEMY_PORT=5001
FRONTEND_PORT=4000

# Shared MongoDB Atlas Connection String
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Shared JWT Secret Key
JWT_SECRET=change_this_to_a_long_random_secret

# Shared Email / Gmail SMTP Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_16_digit_app_password

# Shared Cloudinary Media Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Optional: Google Gemini API Key for Welcome Agent AI Chatbot
GEMINI_API_KEY=your_gemini_api_key_here
