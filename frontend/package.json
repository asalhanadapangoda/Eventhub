{
  "name": "trace-frontends",
  "private": true,
  "scripts": {
    "install:all": "npm --prefix Event-and-Space install && npm --prefix Community-project-main/client install && npm --prefix Innovation-Academy-main/client install",
    "dev": "node scripts/dev-all.mjs",
    "dev:events": "npm --prefix Event-and-Space run dev",
    "dev:community": "npm --prefix Community-project-main/client run dev",
    "dev:academy": "npm --prefix Innovation-Academy-main/client run dev",
    "build": "node scripts/build-all.mjs",
    "build:events": "npm --prefix Event-and-Space run build",
    "build:community": "npm --prefix Community-project-main/client run build",
    "build:academy": "npm --prefix Innovation-Academy-main/client run build",
    "lint": "npm --prefix Event-and-Space run lint",
    "preview": "npm --prefix Event-and-Space run preview"
  }
}
