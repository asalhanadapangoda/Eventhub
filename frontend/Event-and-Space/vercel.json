{
  "redirects": [
    {
      "source": "/",
      "destination": "/events",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://eventhub-kyn9.onrender.com/api/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "https://eventhub-kyn9.onrender.com/uploads/$1"
    },
    {
      "source": "/events",
      "destination": "/index.html"
    },
    {
      "source": "/events/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/spaces",
      "destination": "/index.html"
    },
    {
      "source": "/spaces/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
